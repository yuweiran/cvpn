# Copy to deploy/.env. Never commit deploy/.env.
# Stable upstream release; a locally built image may also be used.
WG_EASY_IMAGE=ghcr.io/wg-easy/wg-easy:15.5.0

# Keep this name stable so Compose keeps using the same data volume.
COMPOSE_PROJECT_NAME=cvpn

# UDP port: host and container use the same port.
# During interactive setup, choose this same port in the Web UI.
VPN_PORT=51820

# The Web UI is always published on 127.0.0.1, never on the public IP.
WEB_UI_PORT=51821

# false: configure admin account and server endpoint in the Web UI.
# true: on the FIRST start of a NEW volume, populate all fields below.
INIT_ENABLED=false
INIT_USERNAME=
# Single quotes keep $ and # literal in Compose dotenv files.
INIT_PASSWORD=
VPN_HOST=
INIT_DNS=1.1.1.1,1.0.0.1
INIT_ALLOWED_IPS=0.0.0.0/0,::/0

# Remove the initialization credentials after setup and recreate the container.
# INIT_* settings do not update an existing database.
